# ===================================================
# Telegram Bot
# ===================================================
# Получить у @BotFather → /newbot
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Shared local Telegram Bot API server (infra/telegram-bot-api). Set by
# docker-compose to http://telegram-bot-api:8081; leave empty for
# api.telegram.org directly.
TELEGRAM_LOCAL_API_URL=

# ===================================================
# Ollama Model
# ===================================================
# Рекомендованные модели для 8 ядер / 16 GB RAM:
#   qwen2.5:7b   — лучший баланс качества и скорости
#   llama3.2:3b  — быстрее, меньше ОЗУ
#   mistral:7b   — хорошо для общих задач
OLLAMA_MODEL=qwen2.5:7b

# ===================================================
# OpenClaw (опционально — для Telegram через OpenClaw)
# ===================================================
# Если хочешь использовать Telegram через OpenClaw,
# раскомментируй и заполни:
# OPENCLAW_TELEGRAM_TOKEN=your_openclaw_bot_token_here

# ===================================================
# Логирование
# ===================================================
# Уровень логов для бота и бэкенда (slog): debug|info|warn|error
LOG_LEVEL=info
